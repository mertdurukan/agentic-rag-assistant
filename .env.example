# =============================================================================
# Agentic RAG Assistant — environment configuration (EXAMPLE)
# Kopyala:  cp .env.example .env   ve gerçek değerleri .env içine yaz.
# .env asla commit edilmez (bkz. .gitignore).
# =============================================================================

# --- LLM provider seçimi: ollama | openai | anthropic ---
# Geliştirme/eval'de "ollama" (ücretsiz, local). Canlı demoda "openai"/"anthropic".
LLM_PROVIDER=ollama

# Sadece RAGAS judge'ı için override (boş bırakırsan LLM_PROVIDER kullanılır).
# Önerilen: generation=ollama, EVAL_LLM_PROVIDER=anthropic → judge'ın JSON çıktısı
# daha güvenilir, RAGAS metric parse-fail riski düşer; generation hâlâ
# "deploy edilecek sistemle aynı" (ölçtüğümüz sistem == deploy edilen sistem).
EVAL_LLM_PROVIDER=

# Provider'a göre model adı (sadece seçili provider'ınki kullanılır)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Provider API anahtarları (sadece ilgili provider seçiliyse gerekir)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embedding modeli (local, sentence-transformers — ücretsiz) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Cross-encoder re-ranker (local) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Postgres + pgvector ---
# docker-compose ile ayağa kalkan varsayılan değerler:
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragdb

# --- Retrieval parametreleri ---
RETRIEVAL_TOP_K=20          # her retriever'dan çekilecek aday sayısı
RRF_K=60                    # Reciprocal Rank Fusion sabiti
RERANK_TOP_N=5              # re-rank sonrası LLM'e gidecek chunk sayısı
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- arXiv ingestion ---
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
# 30 = pleasant smoke-test (~1-2 dk ingest). Tam corpus için 300-600'e çıkar
# (~10-25 dk; arxiv.Client delay_seconds=3 nedeniyle).
ARXIV_MAX_RESULTS=30

# --- Langfuse observability (opsiyonel; boşsa tracing sessizce kapanır) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent davranışı ---
SELF_CHECK_ENABLED=true
# Kaç REGEN izin verilir (0 → hiç regen yok, sadece 1 üretim). Default 1 →
# 1 ana üretim + 1 regen = en fazla 2 LLM çağrısı (latency/maliyet kontrolü).
MAX_REGEN_ATTEMPTS=1
